{
  // Cloudflare Pages project config
  // Used by: wrangler pages dev (local), wrangler pages deploy (manual CI)
  // GitHub auto-deploy: connect repo in Cloudflare dashboard → Pages → basictexts → Settings → Git
  "name": "basictexts",
  "pages_build_output_dir": ".svelte-kit/cloudflare",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Non-secret runtime vars. The matching secrets (TURNSTILE_SECRET_KEY,
  // GITHUB_TOKEN) are set per-environment via `wrangler pages secret put`.
  "vars": {
    // Public Turnstile site key for the anonymous /feedback form.
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFJdLZ6iHVKR71l-",
    // Hostname allow-list checked against Turnstile Siteverify (comma-separated).
    "TURNSTILE_HOSTNAMES": "basictexts.org,basictexts.pages.dev"
  },

  // KV bindings.
  // SEARCH_LOG          → anonymous search logging (/api/log → functions/api/log.ts)
  // FEEDBACK_RATE_LIMIT → fixed-window per-IP limit for /feedback
  // IDs from: wrangler kv namespace list
  "kv_namespaces": [
    {
      "binding": "SEARCH_LOG",
      "id": "6ce8f70fddab4a9eabc38e4bd751140b"
    },
    {
      "binding": "FEEDBACK_RATE_LIMIT",
      "id": "511ffd1e379c43b18d5e792a6d8bd235"
    }
  ]
}
