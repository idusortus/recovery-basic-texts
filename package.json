    "icons:pwa": "node scripts/generate-pwa-icons.mjs",
    "validate:corpus": "node corpus/scripts/validate.js",
    "verify:citations": "node corpus/scripts/verify-citations.mjs",
    "test:concordance": "node corpus/scripts/test-concordance-offsets.mjs",
    "test:corpus-headers": "node corpus/scripts/test-corpus-headers.mjs",
    "test:feedback": "node scripts/test-feedback.mjs",
    "test:pwa-icons": "node scripts/test-pwa-icons.mjs",
    "test:source-badge": "node scripts/test-source-badge.mjs",
    "test:install-prompt": "node scripts/test-install-prompt.mjs",
    "test:source-link": "node scripts/test-source-link.mjs",
    "test:url-state": "node scripts/test-url-state.mjs",
    "test:recent-searches": "node scripts/test-recent-searches.mjs",
    "test:reader-prefs": "node scripts/test-reader-prefs.mjs",
    "test:tts": "node scripts/test-tts.mjs",
    "test:result-label": "node scripts/test-result-label.mjs",
    "test:zero-result": "node scripts/test-zero-result.mjs",
    "test:report-prefill": "node scripts/test-report-prefill.mjs",
    "test:reflection": "node scripts/test-reflection.mjs",
    "test:ui-copy": "node scripts/test-ui-copy.mjs",
    "test:ingest": "python3 corpus/scripts/test-ingest-headers.py",
    "test:search": "node corpus/scripts/build-index.mjs && node scripts/test-search.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-cloudflare": "^4.9.0",
