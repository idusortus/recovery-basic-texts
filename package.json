    "globals": "^17.12.0",
    "prettier": "^3.8.0",
    "prettier-plugin-svelte": "^3.5.2",
    "sharp": "0.34.5",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.21",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.105.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.21.0",
