# Example environment for local development.
# Copy to `.env` (which is gitignored) and adjust as needed.
#
# Local dev uses Cloudflare's published Turnstile TEST keys, which always pass
# and need no account. The test secret returns `hostname: example.com` with no
# action, so the server skips the action/hostname checks when a test secret is
# configured. Never use test keys in production.

# Public Turnstile site key (safe to expose to the browser).
# Test key below always passes: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Turnstile secret key (server-only). The matching always-pass test secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Comma-separated hostname allow-list checked against Siteverify's `hostname`.
# Production value e.g. `basictexts.org,basictexts.pages.dev` (never `localhost`).
TURNSTILE_HOSTNAMES=localhost

# Fine-grained GitHub PAT with `Issues: Read and write` on
# idusortus/recovery-basic-texts. Server-only. Never commit a real token.
GITHUB_TOKEN=ghp_replace_me
