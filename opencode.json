{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "small_model": "opencode-go/qwen3.8-flash",
  "subagent_depth": 2,
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "$cliFive": {
    "blocks": [
      "codegraph",
      "jev"
    ]
  },
  "plugins": [
    ".opencode/plugin/jev-tier-router"
  ]
}
